# ============================================================
# FINBRIDGE — Root Environment Variables
# This file documents all env vars used across the project.
# See backend/.env.example and frontend/.env.local.example
# for service-specific variables.
# ============================================================

# --- Backend ---
# (See backend/.env.example)
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/finbridge

# --- Frontend ---
# (See frontend/.env.local.example)
NEXT_PUBLIC_API_URL=http://localhost:8000
