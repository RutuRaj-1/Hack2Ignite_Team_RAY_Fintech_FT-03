# ============================================================
# FINBRIDGE — Backend Environment Variables (Part 02)
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
# SQLite (zero-setup local development — default)
DATABASE_URL=sqlite+aiosqlite:///./finbridge.db

# PostgreSQL / Supabase (production):
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Firebase Admin (backend token verification) ---
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# --- Supabase (optional direct client) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- ML ---
ML_MODELS_PATH=./data/models
