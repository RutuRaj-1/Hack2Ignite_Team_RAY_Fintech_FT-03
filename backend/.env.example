# ============================================================
# FINBRIDGE — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database (PostgreSQL / Supabase) ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/finbridge
# For Supabase, replace with:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Supabase (direct client, optional) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- JWT Auth ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- ML ---
ML_MODELS_PATH=./data/models

# --- External APIs (Government Schemes) ---
# SCHEME_API_KEY=your-api-key
